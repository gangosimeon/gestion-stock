# Nginx du conteneur front : application Angular + relais /api vers le backend.
# Le HTTPS est terminé en amont (reverse proxy public, voir docs/production.md).
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  # En-têtes de sécurité (complétés par HSTS sur le reverse proxy HTTPS), dans un seul fichier
  # (deploy/security-headers.conf). Dans nginx, un add_header de location remplace TOUS ceux hérités du serveur :
  # chaque location qui ajoute un en-tête inclut donc aussi ce fichier, sinon elle perd les en-têtes de sécurité.
  # Referrer-Policy par défaut ; une location peut la remplacer (set) avant l'inclusion.
  set $geststock_referrer_policy "strict-origin-when-cross-origin";
  include /etc/nginx/snippets/security-headers.conf;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # Santé du conteneur front (sans dépendre du backend).
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }

  # API : même origine pour le navigateur.
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_connect_timeout 5s;
    proxy_read_timeout 90s;
    client_max_body_size 10m;
  }

  # Fichiers versionnés (hash dans le nom) : cache long.
  location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|ico)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri =404;
  }

  # Écran de consentement d'une liaison boutique (lot 2, GA1) : aucun Referer vers un autre site (le lien porte le
  # request_uri avant que l'écran ne le retire de l'URL), jamais mis en cache.
  location ^~ /integrations/ {
    set $geststock_referrer_policy "no-referrer";
    add_header Cache-Control "no-store" always;
    include /etc/nginx/snippets/security-headers.conf;
    # Même repli que la location / (fichier existant, sinon l'application), mais /index.html servi DANS cette
    # location (=404 en dernier) : une redirection interne vers /index.html reprendrait les en-têtes de location /
    # et perdrait no-referrer (observé).
    try_files $uri $uri/ /index.html =404;
  }

  # Application monopage : toute autre route renvoie index.html, jamais mis en cache.
  location / {
    add_header Cache-Control "no-cache";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri $uri/ /index.html;
  }
}
